import { formatDate, formatter } from '@/pages/utils';
import { LookupDataItem } from '@/services/data';
import { DeleteOutlined, DownOutlined } from '@ant-design/icons';
import {
  ModalForm,
  ModalFormProps,
  ProCard,
  ProDescriptions,
  ProForm,
  ProFormDigit,
  ProFormMoney,
  ProFormSelect,
  ProFormTextArea,
  ProTable,
} from '@ant-design/pro-components';
import { Button, Dropdown, MenuProps, message, Space } from 'antd';
import { useForm } from 'antd/es/form/Form';
import _ from 'lodash';
import { useEffect, useState } from 'react';
import { PriceCompareQuotationItem, PriceComparisonItemRs } from './data';

export type AddPriceComparisonItem = {
  key: string;
  // item: PriceComparisonItemRs;
  itemId: number;
  itemCode?: string;
  itemName: string;
  description?: string;
  onRequestQty: number;
  targetPrice?: number;
  qty: number;
  seq: number;
  uomId?: number;
  discountPercentage?: number;
  uomName?: string;
  uomList: LookupDataItem[];
};

type DataFormType = {
  description?: string;
  targetPrice?: number;
  qty: number;
  uomId: number;
};

export default ({
  item: { key, qty, description, uomId, targetPrice },
  onSave,
  isService,
  ...props
}: ModalFormProps & {
  isService?: boolean;
  item: AddPriceComparisonItem;
  onSave: (item: AddPriceComparisonItem) => void;
}) => {
  // const [selectedRowKeys, setSelectedRowKeys] = useState<React.Key[]>(
  //   item.quotationItems.map((it) => it.id),
  // );

  const [data, setData] = useState<PriceCompareQuotationItem[]>();
  const [form] = useForm<DataFormType>();

  const onClick =
    (r: PriceCompareQuotationItem): MenuProps['onClick'] =>
    ({ key }) => {
      if (key == 'first') {
        setData((v) => v?.map((it) => (it.id == r.id ? { ...it, offerType: 'first' } : it)));
      } else {
        setData((v) => v?.map((it) => (it.id == r.id ? { ...it, offerType: 'last' } : it)));
      }
    };

  const items = (vendorId: number, singleQuote?: boolean): MenuProps['items'] => [
    {
      label: 'First offer',
      key: 'first',
      disabled: data?.some((it) => it.offerType == 'first' && it.vendor.id == vendorId),
    },
    {
      label: 'Last offer',
      key: 'last',
      disabled:
        singleQuote || data?.some((it) => it.offerType == 'last' && it.vendor.id == vendorId),
    },
  ];

  useEffect(() => {
    const sortList = _.sortBy<PriceCompareQuotationItem>(
      item.quotationItems,
      (it) => it.issuedDate,
    );
    const groupByVendors = _.groupBy<PriceCompareQuotationItem>(sortList, (it) => it.vendor.id);

    const vendorIdList = _.uniq(sortList.map((it) => it.vendor.id));

    const itemList = vendorIdList.flatMap((id) => {
      const quotations = groupByVendors[id];
      const first = _.first(quotations);
      const last = _.last(quotations);
      const singleQuote = quotations.length == 1;
      return quotations.flatMap((it) => {
        if (it.id == first?.id) {
          return {
            ...it,
            offerType: 'first',
            singleQuote: singleQuote,
          } as PriceCompareQuotationItem;
        }

        if (it.id == last?.id) {
          return { ...it, offerType: 'last' } as PriceCompareQuotationItem;
        }

        return { ...it, singleQuote: singleQuote } as PriceCompareQuotationItem;
      });
    });

    setData(itemList);

    const quotationItem = item.quotationItems.find((it) => it);

    form.setFieldsValue({
      targetPrice: targetPrice || item.targetPrice,
      description: description || quotationItem?.description,
      uomId: uomId || quotationItem?.uom.id,
      qty: qty || quotationItem?.qty || 1,
    });
  }, []);

  const firsOfferList = data?.filter((it) => it.offerType == 'first') || [];
  const lastOfferList = data?.filter((it) => it.offerType == 'last') || [];

  return (
    <ModalForm
      form={form}
      title={`${isService ? 'Add Service' : 'Add Item'}`}
      width={1000}
      {...props}
      onFinish={async () => {
        if (!data) {
          message.error('No items available.');
          return false;
        }
        if (!data.some((it) => it.offerType)) {
          message.error('No item selected.');
          return false;
        }

        const dataForm = await form.validateFields();
        onSave({
          key: key,
          item: { ...item, quotationItems: data },
          qty: dataForm.qty || 1,
          description: dataForm.description,
          uomId: dataForm.uomId,
          targetPrice: dataForm.targetPrice,
        });
        return true;
      }}
    >
      <ProCard direction="column" size="small" gutter={5}>
        <ProCard size="small" bordered title="Product Info">
          <ProDescriptions<PriceComparisonItemRs>
            dataSource={item}
            columns={[
              { title: 'Item Code', hideInDescriptions: isService, dataIndex: 'itemCode' },
              { title: 'Item Name', dataIndex: 'itemName' },
              {
                title: 'Description',
                render: (_, r) => description || r.quotationItems.find((it) => it)?.description,
              },
              {
                title: 'Current Target Price',
                hideInDescriptions: isService,
                dataIndex: 'targetPrice',
              },
            ]}
          />
        </ProCard>
        {(data?.filter((it) => !it.offerType)?.length || 0) > 0 && (
          <ProTable<PriceCompareQuotationItem>
            size="small"
            rowKey={'id'}
            headerTitle={'Unassigned'}
            search={false}
            options={false}
            pagination={false}
            dataSource={data?.filter((it) => !it.offerType)}
            columns={[
              { title: 'Issued.Date', render: (_, r) => formatDate(r.issuedDate) },
              { title: 'Vendor', render: (_, r) => [r.vendor.code, r.vendor.name].join(', ') },
              { title: 'Quote #', render: (_, r) => r.quotationNo },
              {
                title: 'PR #',
                render: (_, r) => r.requisitionList.map((it) => it.code).join(', '),
              },
              { title: 'Description', render: (_, r) => r.description },
              { title: 'UoM', hideInTable: isService, render: (_, r) => r.uom.name },
              { title: 'Qty', hideInTable: isService, align: 'right', render: (_, r) => r.qty },
              {
                title: 'Price',
                hideInTable: isService,
                align: 'right',
                render: (_, r) => formatter.format(r.price),
              },
              { title: 'Amount', align: 'right', render: (_, r) => formatter.format(r.amount) },
              {
                render: (_, r) => {
                  return (
                    <Dropdown
                      menu={{ items: items(r.vendor.id, r.singleQuote), onClick: onClick(r) }}
                    >
                      <a onClick={(e) => e.preventDefault()}>
                        <Space>
                          Add To
                          <DownOutlined />
                        </Space>
                      </a>
                    </Dropdown>
                  );
                },
              },
            ]}
          />
        )}

        <ProTable<PriceCompareQuotationItem>
          size="small"
          rowKey={'id'}
          headerTitle={'First Price offer'}
          search={false}
          options={false}
          pagination={false}
          dataSource={firsOfferList}
          columns={[
            { title: 'Issued.Date', render: (_, r) => formatDate(r.issuedDate) },
            {
              title: 'Vendor',
              render: (_, r) => [r.vendor.code, r.vendor.name].filter((it) => it).join(', '),
            },
            { title: 'Quote #', render: (_, r) => r.quotationNo },
            {
              title: 'PR #',
              render: (_, r) => r.requisitionList.map((it) => it.code).join(', '),
            },
            { title: 'Description', render: (_, r) => r.description },
            { title: 'UoM', hideInTable: isService, render: (_, r) => r.uom.name },
            { title: 'Qty', hideInTable: isService, align: 'right', render: (_, r) => r.qty },
            {
              title: 'Price',
              hideInTable: isService,
              align: 'right',
              render: (_, r) => formatter.format(r.price),
            },
            { title: 'Amount', align: 'right', render: (_, r) => formatter.format(r.amount) },
            {
              width: 70,
              render: (_, r) => {
                return (
                  <Button
                    danger
                    type="link"
                    icon={<DeleteOutlined />}
                    onClick={() => {
                      setData((v) =>
                        v?.map((it) => (it.id == r.id ? { ...it, offerType: undefined } : it)),
                      );
                    }}
                  />
                );
              },
            },
          ]}
        />

        <ProTable<PriceCompareQuotationItem>
          size="small"
          rowKey={'id'}
          headerTitle={'Last Price offer'}
          search={false}
          options={false}
          pagination={false}
          dataSource={[
            ...firsOfferList.filter(
              (it) => !lastOfferList.some((it1) => it.vendor.id == it1.vendor.id),
            ),
            ...lastOfferList,
          ]}
          columns={[
            { title: 'Issued.Date', render: (_, r) => formatDate(r.issuedDate) },
            {
              title: 'Vendor',
              render: (_, r) => [r.vendor.code, r.vendor.name].filter((it) => it).join(', '),
            },
            { title: 'Quote #', render: (_, r) => r.quotationNo },
            {
              title: 'PR #',
              render: (_, r) => r.requisitionList.map((it) => it.code).join(', '),
            },
            { title: 'Description', render: (_, r) => r.description },
            { title: 'UoM', hideInTable: isService, render: (_, r) => r.uom.name },
            { title: 'Qty', hideInTable: isService, align: 'right', render: (_, r) => r.qty },
            {
              title: 'Price',
              hideInTable: isService,
              align: 'right',
              render: (_, r) => formatter.format(r.price),
            },
            { title: 'Amount', align: 'right', render: (_, r) => formatter.format(r.amount) },
            {
              width: 70,
              render: (_, r) =>
                r.offerType == 'last' && (
                  <Button
                    danger
                    type="link"
                    icon={<DeleteOutlined />}
                    onClick={() => {
                      setData((v) =>
                        v?.map((it) => (it.id == r.id ? { ...it, offerType: undefined } : it)),
                      );
                    }}
                  />
                ),
            },
          ]}
        />

        <ProCard size="small" boxShadow bordered>
          <ProForm.Group>
            <Space size={5}>
              <ProFormTextArea
                width={'sm'}
                name={'description'}
                label="Description"
                fieldProps={{
                  rows: 1,
                }}
              />
              {!isService && (
                <ProFormDigit
                  rules={[{ required: true }]}
                  min={1}
                  width={'sm'}
                  name={'qty'}
                  label="Quantity"
                />
              )}
              {!isService && (
                <ProFormSelect
                  rules={[{ required: true }]}
                  width={'sm'}
                  options={item.uomList.map((it) => ({ label: it.name, value: it.id }))}
                  name={'uomId'}
                  label="UoM"
                />
              )}
              <ProFormMoney
                fieldProps={{ precision: 2 }}
                width={'sm'}
                rules={[{ required: true }]}
                name={'targetPrice'}
                label="Target Price"
              />
            </Space>
          </ProForm.Group>
        </ProCard>
      </ProCard>
    </ModalForm>
  );
};
