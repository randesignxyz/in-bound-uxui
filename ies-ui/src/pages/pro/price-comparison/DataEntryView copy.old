import { ProcessFlowModalWrapper } from '@/pages/process-flow/components/ProcessFlowModalWrapper';
import { formatter } from '@/pages/utils';
import { RequisitionItemDetailResponse } from '@/services/pro/data';
import { RequisitionServiceAPI } from '@/services/pro/services';
import { ArrowDownOutlined, ArrowUpOutlined, PlusOutlined } from '@ant-design/icons';
import {
  FooterToolbar,
  PageContainer,
  ProCard,
  ProForm,
  ProFormTextArea,
  ProTable,
  Statistic,
} from '@ant-design/pro-components';
import { Button, Checkbox, message, Space, Table } from 'antd';
import { useForm } from 'antd/lib/form/Form';
import _ from 'lodash';
import { useState } from 'react';
import { QuotationItemtDetail } from '../quotation/data';
import { VendorDetail } from '../vendor/vendor';
import { RequisitionDetailWithQuotatopmResponse } from './data';
import ItemFinder from './ItemFinder';

import { createPriceComparisonService } from './service';

type FormType = {
  vendor: string;
  quotationId: number;
  justification?: string;
};

export default ({
  id,
  onBack,
  onEdit,
  onAdd,
}: {
  id?: number;
  type: 'CREATE' | 'EDIT';
  onBack: () => void;
  onAdd?: (id?: number) => void;
  onEdit?: (id: number) => void;
}) => {
  const priceComparisonSrv = createPriceComparisonService();
  const requestActions = priceComparisonSrv.requestAction;
  const srv = RequisitionServiceAPI(requestActions);
  const [detail, setDetail] = useState<RequisitionDetailWithQuotatopmResponse>();
  const [vendors, setVendors] = useState<VendorDetail[]>();
  const [form] = useForm<FormType>();
  const [selectedPrice, setSelectedPrice] = useState<number>();
  const [selectedQuotation, setSelectedQuotation] = useState<number>();
  const [startFormVisible, setStartFormVisible] = useState(false);

  // const onSearchPR = async ({ keywords }: { keywords?: string }) => {
  //     const rs = await srv.list({
  //         criteria: {
  //             searchValue: keywords,
  //             advanceSearch: {
  //                 integratedStatus: "POSTED",
  //                 status: "APPROVED",
  //             }
  //         },
  //     })
  //     const dataItems = rs.items.map(it => ({ label: [it.formNo, it.sapDocNo, it.requestedBy].filter(it => it).join("/ "), value: it.id }))
  //     return dataItems
  // }

  const fetchDetail = async (ids: number[]) => {
    try {
      const rs = await srv.detailsWithQuotations(ids);
    } catch (error: any) {
      message.error(error.message || 'Failed to fetch data.');
    }
  };

  const linkQuote = (records: RequisitionItemDetailResponse) => {
    const quoteItems = detail?.quotationList
      .flatMap((it) => it.items.map((i) => ({ ...i, code: it.code, vendor: it.vendorName })))
      .filter((it) => it.prLinked.some((i) => i == records.id))
      .sort((a, b) => a.amount - b.amount);
    const min = _.minBy<number>(quoteItems?.map((it) => it.amount)) || 0;

    return (
      <Table<QuotationItemtDetail & { code: string; vendor: string }>
        size="small"
        rowKey={'id'}
        pagination={false}
        dataSource={quoteItems}
        columns={
          detail?.service
            ? [
                { title: 'Vendor', dataIndex: 'vendor' },
                { title: 'Quote #', dataIndex: 'code' },
                { title: 'Price', render: (_, r) => formatter.format(r.price) },
                { title: 'Amount', render: (_, r) => formatter.format(r.amount) },
                {
                  title: '',
                  render: (_, r) => (
                    <Statistic
                      value={r.amount / min - 1}
                      precision={2}
                      valueStyle={{ color: r.amount / min - 1 <= 0 ? '#3f8600' : '#cf1322' }}
                      prefix={
                        r.amount / min - 1 != 0 &&
                        (r.amount / min - 1 > 0 ? <ArrowUpOutlined /> : <ArrowDownOutlined />)
                      }
                      suffix="%"
                    />
                  ),
                },
              ]
            : [
                { title: 'Vendor', dataIndex: 'vendor' },
                { title: 'Quote', dataIndex: 'code' },
                { title: 'Qty', dataIndex: 'qty' },
                { title: 'UoM', dataIndex: 'uomName' },
                { title: 'Price', render: (_, r) => formatter.format(r.price) },
                { title: 'Amount', render: (_, r) => formatter.format(r.amount) },
                {
                  title: '',
                  render: (_, r) => (
                    <Statistic
                      value={r.amount / min - 1}
                      precision={2}
                      valueStyle={{ color: r.amount / min - 1 <= 0 ? '#3f8600' : '#cf1322' }}
                      prefix={
                        r.amount / min - 1 != 0 &&
                        (r.amount / min - 1 > 0 ? <ArrowUpOutlined /> : <ArrowDownOutlined />)
                      }
                      suffix="%"
                    />
                  ),
                },
              ]
        }
      />
    );
  };

  return (
    <PageContainer title="Price Comparison Requisition Form" onBack={() => history.back()}>
      <ProForm
        form={form}
        submitter={{
          render: () => (
            <FooterToolbar>
              <Button style={{ marginRight: 10 }} onClick={onBack}>
                Cancel
              </Button>
              <Button
                onClick={() => {
                  form.resetFields(['vendor', 'quotationId', 'justification']);
                  setSelectedQuotation(undefined);
                }}
              >
                {' '}
                Clear{' '}
              </Button>
              <Button
                disabled={!detail}
                type="primary"
                onClick={async () => {
                  if (!selectedQuotation) {
                    message.error('Please select quotation.');
                    return;
                  }
                  setStartFormVisible(true);
                }}
              >
                Submit
              </Button>
            </FooterToolbar>
          ),
        }}
        onValuesChange={(changedVaues) => {
          const { requisitionId, quotationId, vendor } = changedVaues;
          if ('requisitionId' in changedVaues) {
            fetchDetail(requisitionId);
          }

          if ('vendor' in changedVaues) {
            // setSelectedVendor(vendor)
            setSelectedQuotation(undefined);
            form.resetFields(['quotationId']);
          }
          if ('quotationId' in changedVaues) {
            setSelectedQuotation(quotationId);
          }
        }}
      >
        <ProCard direction="column">
          {/* <ProCard bordered size="small" title="Criteria">
                    <ProFormSelect
                        placeholder={"PR No, Request No, Requestor"}
                        name={"requisitionId"} showSearch allowClear
                        request={onSearchPR} />
                </ProCard> */}

          <ProCard
            bordered
            size="small"
            title="Comparison list"
            style={{ marginBlockStart: 8 }}
            extra={
              <ItemFinder
                onSave={(item) => {}}
                trigger={
                  <Button type="link" icon={<PlusOutlined />}>
                    Add Items/Services
                  </Button>
                }
              />
            }
          >
            {detail && (
              <ProTable<RequisitionItemDetailResponse>
                search={false}
                pagination={false}
                dataSource={detail?.items}
                size="small"
                options={false}
                rowKey={'id'}
                bordered
                expandable={{
                  expandedRowRender: linkQuote,
                  rowExpandable: (record) =>
                    detail?.quotationList
                      .flatMap((it) => it.items.flatMap((it1) => it1.prLinked))
                      .some((it) => record.id) || false,
                }}
                columns={[
                  { title: '#', dataIndex: 'seqNo' },
                  {
                    title: 'Item Code',
                    dataIndex: 'itemCode',
                    fieldProps: { style: { color: 'red' } },
                    formItemProps: { style: { color: 'red' } },
                  },
                  { title: 'Item Name', dataIndex: 'itemName' },
                  //{ title: 'Description', dataIndex: 'description' },
                  { title: 'Qty', align: 'right', dataIndex: 'qty' },
                  { title: 'UoM', dataIndex: 'uom' },
                  {
                    title: 'Target Price',
                    align: 'right',
                    render: (_, r) => formatter.format(r.unitPrice),
                  },
                  //{ title: 'Amount', align: 'right', render: (_, r) => formatter.format(r.amount) },
                  {
                    title: 'First Offer Unit Price',
                    proFieldProps: {},
                    children: vendors?.map((it) => ({
                      title: it.name,
                      align: 'right',

                      render: (_, r) => {
                        const quotations = detail.quotationList.filter((i) => i.vendor.id == it.id);
                        const quotation = quotations
                          .filter((i) => i.items.some((i1) => i1.itemCode == r.itemCode))
                          .find((it) => it);
                        const data = quotation?.items
                          .filter((i) => i.itemCode == r.itemCode)
                          .find((it) => it);

                        return (
                          data?.price && (
                            <Space>
                              {formatter.format(data.price)}
                              {quotation?.id == selectedQuotation && selectedPrice == 1 && (
                                <Checkbox checked />
                              )}
                            </Space>
                          )
                        );
                      },
                    })),
                  },
                  {
                    title: 'Second Offer Unit Price',
                    children: vendors?.map((it) => ({
                      title: it.name,
                      align: 'right',
                      render: (_, r) => {
                        const quotations = detail.quotationList.filter((i) => i.vendor.id == it.id);
                        const quotation = quotations
                          .filter((i) => i.items.some((i1) => i1.itemCode == r.itemCode))
                          .pop();
                        const data = quotation?.items
                          .filter((i) => i.itemCode == r.itemCode)
                          .find((it) => it);
                        return (
                          data?.price && (
                            <Space>
                              {formatter.format(data.price)}
                              {quotation?.id == selectedQuotation && selectedPrice == 2 && (
                                <Checkbox checked />
                              )}
                            </Space>
                          )
                        );
                      },
                    })),
                  },
                ]}
                summary={() => (
                  <Table.Summary fixed>
                    <Table.Summary.Row style={{ fontWeight: 'bold' }}>
                      <Table.Summary.Cell align="right" colSpan={7} index={0}>
                        Total
                      </Table.Summary.Cell>
                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`total-1-${index}`}
                          align="right"
                          index={index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .find((it) => it)?.totalAmount;
                            return data && formatter.format(data);
                          })()}
                        </Table.Summary.Cell>
                      ))}

                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`total-2-${index}`}
                          align="right"
                          index={vendors.length + index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .pop()?.totalAmount;
                            return data && formatter.format(data);
                          })()}
                        </Table.Summary.Cell>
                      ))}
                    </Table.Summary.Row>
                    <Table.Summary.Row>
                      <Table.Summary.Cell align="right" colSpan={7} index={0}>
                        Discount
                      </Table.Summary.Cell>
                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`discount-1-${index}`}
                          align="right"
                          index={index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .find((it) => it)?.discountAmount;
                            return data && formatter.format(data);
                          })()}
                        </Table.Summary.Cell>
                      ))}

                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`discount-2-${index}`}
                          align="right"
                          index={vendors.length + index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .pop()?.discountAmount;
                            return data && formatter.format(data);
                          })()}
                        </Table.Summary.Cell>
                      ))}
                    </Table.Summary.Row>
                    <Table.Summary.Row style={{ fontWeight: 'bold' }}>
                      <Table.Summary.Cell align="right" colSpan={7} index={0}>
                        Total After Discount
                      </Table.Summary.Cell>
                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`after-dis-1-${index}`}
                          align="right"
                          index={index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .find((it) => it)?.paymentDue;
                            return data && formatter.format(data);
                          })()}
                        </Table.Summary.Cell>
                      ))}

                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`after-dis-2-${index}`}
                          align="right"
                          index={vendors.length + index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .pop()?.paymentDue;
                            return data && formatter.format(data);
                          })()}
                        </Table.Summary.Cell>
                      ))}
                    </Table.Summary.Row>
                    <Table.Summary.Row>
                      <Table.Summary.Cell align="right" colSpan={7} index={0}>
                        Duty/Tax
                      </Table.Summary.Cell>
                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell key={`tax-1-${index}`} align="right" index={index + 1}>
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .find((it) => it)?.tax;
                            return data;
                          })()}
                        </Table.Summary.Cell>
                      ))}

                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`tax-2-${index}`}
                          align="right"
                          index={vendors.length + index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .pop()?.tax;
                            return data;
                          })()}
                        </Table.Summary.Cell>
                      ))}
                    </Table.Summary.Row>
                    <Table.Summary.Row>
                      <Table.Summary.Cell align="right" colSpan={7} index={0}>
                        Freight/Delivery
                      </Table.Summary.Cell>
                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`freight-1-${index}`}
                          align="right"
                          index={index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .find((it) => it)?.leadTime;
                            return data;
                          })()}
                        </Table.Summary.Cell>
                      ))}

                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`tax-2-${index}`}
                          align="right"
                          index={vendors.length + index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .pop()?.leadTime;
                            return data;
                          })()}
                        </Table.Summary.Cell>
                      ))}
                    </Table.Summary.Row>
                    <Table.Summary.Row style={{ fontWeight: 'bold' }}>
                      <Table.Summary.Cell align="right" colSpan={7} index={0}>
                        Total (Gross)
                      </Table.Summary.Cell>
                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`gross-1-${index}`}
                          align="right"
                          index={index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .find((it) => it)?.paymentDue;
                            return data && formatter.format(data);
                          })()}
                        </Table.Summary.Cell>
                      ))}

                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`gross-2-${index}`}
                          align="right"
                          index={vendors.length + index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .pop()?.paymentDue;
                            return data && formatter.format(data);
                          })()}
                        </Table.Summary.Cell>
                      ))}
                    </Table.Summary.Row>
                    <Table.Summary.Row>
                      <Table.Summary.Cell align="right" colSpan={7} index={0}>
                        Delivery Lead time
                      </Table.Summary.Cell>
                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`lead-time-1-${index}`}
                          align="right"
                          index={index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .find((it) => it)?.leadTime;
                            return data;
                          })()}
                        </Table.Summary.Cell>
                      ))}

                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`lead-time-2-${index}`}
                          align="right"
                          index={vendors.length + index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .pop()?.leadTime;
                            return data;
                          })()}
                        </Table.Summary.Cell>
                      ))}
                    </Table.Summary.Row>
                    <Table.Summary.Row>
                      <Table.Summary.Cell align="right" colSpan={7} index={0}>
                        Warranty
                      </Table.Summary.Cell>
                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`warranty-1-${index}`}
                          align="right"
                          index={index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .find((it) => it)?.warranty;
                            return data;
                          })()}
                        </Table.Summary.Cell>
                      ))}

                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`warranty-2-${index}`}
                          align="right"
                          index={vendors.length + index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .pop()?.warranty;
                            return data;
                          })()}
                        </Table.Summary.Cell>
                      ))}
                    </Table.Summary.Row>
                    <Table.Summary.Row>
                      <Table.Summary.Cell align="right" colSpan={7} index={0}>
                        Payment Term
                      </Table.Summary.Cell>
                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`payment-term-1-${index}`}
                          align="right"
                          index={index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .find((it) => it)?.paymentTerm;
                            return data;
                          })()}
                        </Table.Summary.Cell>
                      ))}

                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`payment-term-2-${index}`}
                          align="right"
                          index={vendors.length + index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .pop()?.paymentTerm;
                            return data;
                          })()}
                        </Table.Summary.Cell>
                      ))}
                    </Table.Summary.Row>

                    <Table.Summary.Row>
                      <Table.Summary.Cell align="right" colSpan={7} index={0}>
                        Quotation No
                      </Table.Summary.Cell>
                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`quotation-1-${index}`}
                          align="right"
                          index={index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .find((it) => it);
                            return (
                              <Space>
                                {data?.code}
                                {(!selectedQuotation ||
                                  (selectedQuotation == data?.id && selectedPrice == 1)) && (
                                  <Checkbox
                                    onChange={(e) => {
                                      if (e.target.checked) {
                                        setSelectedPrice(1);
                                        setSelectedQuotation(data?.id);
                                      } else {
                                        setSelectedPrice(0);
                                        setSelectedQuotation(undefined);
                                      }
                                    }}
                                  />
                                )}
                              </Space>
                            );
                          })()}
                        </Table.Summary.Cell>
                      ))}

                      {vendors?.map((it, index) => (
                        <Table.Summary.Cell
                          key={`quotation-2-${index}`}
                          align="right"
                          index={vendors.length + index + 1}
                        >
                          {(() => {
                            const data = detail.quotationList
                              .filter((i) => i.vendor.id == it.id)
                              .pop();
                            return (
                              <Space>
                                {data?.code}
                                {(!selectedQuotation ||
                                  (selectedQuotation == data?.id && selectedPrice == 2)) && (
                                  <Checkbox
                                    onChange={(e) => {
                                      if (e.target.checked) {
                                        setSelectedQuotation(data?.id);
                                        setSelectedPrice(2);
                                      } else {
                                        setSelectedPrice(0);
                                        setSelectedQuotation(undefined);
                                      }
                                    }}
                                  />
                                )}
                              </Space>
                            );
                          })()}
                        </Table.Summary.Cell>
                      ))}
                    </Table.Summary.Row>
                  </Table.Summary>
                )}
              />
            )}
            {/* <ProFormGroup title="Quotation selection">
                    <ProFormSelect rules={[{ required: true }]} width={'md'} name={'vendor'} label="Vendor" options={_.unionBy<VendorDetail>(detail?.quotationList.map(it => it.vendor), it => it.id).map(it => ({ label: it.name, value: it.code }))} />
                    <ProFormSelect rules={[{ required: true }]} width={'md'} name={'quotationId'} label="Quotation" options={detail?.quotationList.filter(it => it.vendor.code == selectedVendor).map(it => ({ label: it.code, value: it.id }))} />
                </ProFormGroup> */}
          </ProCard>

          {detail && (
            <ProCard
              className="justification"
              title="Recommendations and justifications"
              bordered
              style={{ marginBlockStart: 8 }}
            >
              <ProFormTextArea />
            </ProCard>
          )}
        </ProCard>
      </ProForm>
      <ProcessFlowModalWrapper
        type="action"
        action="Start"
        loading={false}
        noAttachment
        formKey={PriceComparisonFormNames.start}
        // payload={{ from: 'Requisition', id: id }}
        visible={startFormVisible}
        actionHandlers={{
          onStartWorkflow: async (processDef, formKey, buId, requestor, comment) => {
            const data = {
              processDef,
              formKey,
              buId,
              remarks: comment || '',
              requestor: requestor.id,
              priceOfferedTime: 1,
              requisitionId: 1,
              selectedQuotationId: 1,
              quotationList: [],
              requisitionItemList: [],
            };
            try {
              priceComparisonSrv.saveItem(data);
            } catch (error: any) {
              message.error(error.message || 'Failed to make request.');
            }
          },
          onCancel: (_) => {
            setStartFormVisible(false);
          },
        }}
      />
    </PageContainer>
  );
};
